# Configurazione Backend BitM Sentinel

# Scelta del Provider LLM: "gemini", "openai", oppure "ollama"
LLM_PROVIDER=gemini

# Modello specifico da utilizzare:
# Per Gemini: "gemini-2.0-flash" o "gemini-1.5-flash"
# Per OpenAI: "gpt-4o-mini"
# Per Ollama locale: "qwen2.5-coder:7b" o "llama3.2:3b"
LLM_MODEL=gemini-2.0-flash

# API Keys (necessarie solo per i provider Cloud)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Endpoint Ollama (necessario solo se LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Impostazioni Server FastAPI
HOST=0.0.0.0
PORT=8000
